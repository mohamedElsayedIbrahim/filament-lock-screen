{
  "name": "mohamed/filament-lockscreen",
  "description": "Lockscreen system for Filament v3 admin panels",
  "type": "library",
  "version": "1.0.0",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Mohamed\\FilamentLockscreen\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mohamed\\FilamentLockscreen\\LockscreenServiceProvider"
      ]
    }
  },
  "require": {
    "php": ">=8.1",
    "filament/filament": "^3.0",
    "illuminate/support": "^10.0|^11.0"
  },
    "minimum-stability": "stable",
    "prefer-stable": true
}